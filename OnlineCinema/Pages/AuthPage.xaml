<Page x:Class="OnlineCinema.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Вход"
      Background="{DynamicResource BackgroundBrash}">

    <Grid>
        <Border Width="360" Padding="28" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BackgroundBrash}">
            <StackPanel>
                <TextBlock Text="Вход" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Email"/>
                <TextBox x:Name="TextBoxLogin" Height="35" 
                         VerticalContentAlignment="Center" ToolTip="Введите Email" Margin="0,4,0,12"/>
                
                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordBox" Height="35" Margin="0,4,0,20" 
                             HorizontalContentAlignment="Center" ToolTip="Введите пароль"/>

                <Button x:Name="ButtonEnter" Content="Вход" Margin="0,0,0,8" 
                        IsDefault="True" ToolTip="Кнопка входа" Click="ButtonEnter_Click"/>
                <Button x:Name="ButtonReg" Content="Регистрация" Margin="0,0,0,8" 
                        ToolTip="Создать аккаунт" Click="ButtonReg_Click"/>
                <Button x:Name="ButtonGuest" Content="Продолжить как гость" Margin="0,0,0,8" 
                        ToolTip="Посмотреть каталог без входа" Click="ButtonGuest_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

<Page x:Class="OnlineCinema.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля"
      Background="{DynamicResource BackgroundBrash}">

    <Grid>
        <Border Width="380" Padding="28" CornerRadius="10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource HeaderBrush}">
            <StackPanel>
                <TextBlock Text="Смена пароля" FontSize="24pt" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20" />

                <TextBlock Text="Email" />
                <TextBox x:Name="TbLogin" Style="{StaticResource PlaceholderBox}"
                         Tag="name@mail.ru" Margin="0,4,0,12"
                         ToolTip="Email вашего аккаунта" />

                <TextBlock Text="Текущий пароль" />
                <PasswordBox x:Name="PbCurrent" Height="35" Margin="0,4,0,12"
                             VerticalContentAlignment="Center"
                             ToolTip="Введите действующий пароль" />

                <TextBlock Text="Новый пароль (от 6 символов, латиница и цифры)" TextWrapping="Wrap" />
                <PasswordBox x:Name="PbNew" Height="35" Margin="0,4,0,12"
                             VerticalContentAlignment="Center"
                             ToolTip="Минимум 6 символов, только английские буквы и хотя бы одна цифра" />

                <TextBlock Text="Повторите новый пароль" />
                <PasswordBox x:Name="PbConfirm" Height="35" Margin="0,4,0,20"
                             VerticalContentAlignment="Center"
                             ToolTip="Повторите новый пароль" />

                <Button x:Name="ButtonSave" Content="Сменить пароль" Margin="0,0,0,8"
                        IsDefault="True" ToolTip="Сохранить новый пароль" Click="ButtonSave_Click" />
                <Button x:Name="ButtonBack" Content="Назад" Margin="0"
                        ToolTip="Вернуться без изменений" Click="ButtonBack_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

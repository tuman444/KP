<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#EEEEF2" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E50914" />
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5C5C5C" />

    <Style TargetType="Button">
        <Setter Property="Height" Value="35" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="FontSize" Value="12pt" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>